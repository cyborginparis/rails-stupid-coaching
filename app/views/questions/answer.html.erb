<div class="container mt-5">
  <h1>Stupid Coaching</h1>

  <div class="question-box">
    <p><%= @question %></p>
    <p class="mb-0"><em>— You</em></p>
  </div>

  <div class="answer-box">
    <p><strong><%= @answer %></strong></p>
    <p class="mb-0"><em>— Your coach</em></p>
  </div>

  <%= link_to "Ask another question", ask_path, class: "btn btn-outline-primary mt-3" %>
</div>
